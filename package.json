    "db:stop": "podman stop yatra-postgres",
    "db:logs": "podman logs -f yatra-postgres",
    "db:reset": "podman rm -f yatra-postgres && podman run --name yatra-postgres -e POSTGRES_USER=yatra -e POSTGRES_PASSWORD=yatra123 -e POSTGRES_DB=yatraai -p 5433:5432 -d docker.io/postgis/postgis:16-3.4"
  },
