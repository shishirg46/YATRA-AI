{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:db": "npm run db:ensure && next dev --no-turbopack",
    "dev:services": "podman start yatra-postgres nominatim yatra-osrm",
    "dev:all": "concurrently --names \"docker,next\" \"podman start yatra-postgres nominatim yatra-osrm && sleep infinity\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest:disasters:realtime": "npx tsx scripts/ingest-disasters.ts realtime 24",
    "ingest:disasters:historical": "npx tsx scripts/ingest-disasters.ts historical 2020 2026",
    "ingest:disasters:full": "npx tsx scripts/ingest-disasters.ts full 2020 2026 24",
    "check:weather": "npx tsx scripts/check-weather-avail.ts",
    "seed:route-baseline": "npx tsx scripts/seed-route-baseline.ts",
    "prewarm:destinations": "npx tsx scripts/prewarm-destinations.ts",
    "seed:route-templates": "npx tsx scripts/build-route-templates.ts",
    "sync:route-templates": "npx tsx scripts/sync-route-templates-from-json.ts",
    "seed:nepal-routing": "npx tsx scripts/seed-nepal-routing.ts",
    "seed:wikipedia-osm": "npx tsx scripts/seed-wikipedia-osm.ts",
    "db:start": "podman start yatra-postgres",
    "db:ensure": "node scripts/ensure-db.mjs",
    "db:stop": "podman stop yatra-postgres",
    "db:logs": "podman logs -f yatra-postgres",
    "db:reset": "podman rm -f yatra-postgres && podman run --name yatra-postgres -e POSTGRES_USER=yatra -e POSTGRES_PASSWORD=yatra123 -e POSTGRES_DB=yatraai -p 5433:5432 -d docker.io/postgis/postgis:16-3.4",
    "extract:osm": "npx tsx scripts/extract-osm-edges.ts",
    "merge:sources": "npx tsx scripts/merge-topology-sources.ts",
    "stage2:full": "npx tsx scripts/extract-raw-edges.ts && npx tsx scripts/extract-osm-edges.ts && npx tsx scripts/merge-topology-sources.ts && npx tsx scripts/build-topology-graph.ts",
    "build:topology": "npx tsx scripts/stitch-corridors.ts",
    "build:route-chains": "npx tsx scripts/build-route-chains.ts",
    "build:junction-graph": "npx tsx scripts/build-junction-graph.ts",
    "build:routing": "npx tsx scripts/route-engine.ts",
    "import:osm": "tsx scripts/01-import-osm-pbf.ts",
    "import:osm:dry": "tsx scripts/01-import-osm-pbf.ts --dry-run",
    "build:route-graph": "tsx scripts/02-build-route-graph.ts",
    "build:edge-cache": "tsx scripts/03-build-edge-cache.ts",
    "build:route-segments": "tsx scripts/02b-build-route-segments.ts",
    "validate:build": "tsx scripts/04-validate-build.ts",
    "ingest:hazards": "tsx scripts/06-ingest-hazards.ts",
    "precompute:hazards": "tsx scripts/07-precompute-segment-hazards.ts",
    "publish:graph": "tsx scripts/05-publish-graph.ts",
    "cleanup:builds": "tsx scripts/cleanup-builds.ts",
    "validate:routes": "tsx scripts/10-validate-routes.ts",
    "validate:planner": "tsx scripts/12-validate-planner.ts",
    "golden:routes": "tsx scripts/11-golden-routes.ts",
    "golden:routes:update": "tsx scripts/11-golden-routes.ts --update"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/rbush": "^4.0.0",
    "better-auth": "^1.7.0-beta.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "h3-js": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.569.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.21.0",
    "pg-copy-streams": "^7.0.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.9.0",
    "shapefile": "^0.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.42",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "prisma": "^7.8.0",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "kysely": "0.27.5"
  }
}
