# YatraAI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/yatraai?schema=public"

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── External APIs ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY="your-openweather-api-key"
OPENROUTESERVICE_API_KEY="your-ors-api-key"
NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# AI provider — "ollama" (default, free, no API key), "groq", "gemini", or "claude"
# Set AI_PROVIDER to override. Ollama is always preferred first; others are fallbacks.
# For remote Ollama, set OLLAMA_BASE_URL (e.g., "http://your-server:11434").
AI_PROVIDER="ollama"
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Ollama (local or remote, no API key needed)
# OLLAMA_BASE_URL="http://localhost:11434"

# ─── Background assessment cron secret ───────────────────────────────────────
# Generate with: openssl rand -hex 32
# Send as: POST /api/assess with Authorization: Bearer <this value>
ASSESS_SECRET="generate-with-openssl-rand-hex-32"

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="onboarding@resend.dev"

# Gmail app password (alternative)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# ─── File uploads ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

GEONAMES_USERNAME="your-geonames-username"

# ─── Local Services ──────────────────────────────────────────────────────────
# Nominatim (local Docker instance for Nepal reverse geocoding)
NOMINATIM_URL="http://localhost:8080"
OSRM_URL="http://localhost:5000"
