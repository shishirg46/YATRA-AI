model UserPrivacy {
  userId            String @id
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  whoCanSeeName     String @default("everyone")
  whoCanSeeUsername String @default("everyone")
  whoCanSeeLocation String @default("everyone")
  whoCanSeeEmail    String @default("nobody")
  whoCanSeeTrips    String @default("everyone")
  whoCanSeePhotos   String @default("everyone")

  @@map("user_privacy")
}

model TripPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String
  tripId    String?
  caption   String?
  location  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("trip_photo")
}
