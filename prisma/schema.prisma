generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id @default(cuid())
  name             String
  username         String?             @unique
  displayUsername  String?
  email            String              @unique
  emailVerified    Boolean             @default(false)
  image            String?
  phone            String?
  role             Role                @default(USER)
  isActive         Boolean             @default(true)
  homeLocationId   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  auditLogs        AuditLog[]
  receivedRequests Friendship[]        @relation("FriendReceived")
  sentRequests     Friendship[]        @relation("FriendRequests")
  notifications    Notification[]
  createdGroups    TravelGroup[]       @relation("GroupCreator")
  groupMemberships TravelGroupMember[]
  travelPlans      TravelPlan[]        @relation("TripLeader")
  planMemberships  TravelPlanMember[]
  behavior         UserBehavior?
  health           UserHealth?
  preference       UserPreference?
  accounts         Account[]
  sessions         Session[]
  homeLocation     Location?           @relation("HomeLocation", fields: [homeLocationId], references: [id])
  savedLocation    UserSavedLocation?
  savedDestinations SavedDestination[]
  emergencyContacts    EmergencyContact[]
  emergencyAlerts      EmergencyAlert[]
  locationShareSessions LocationShareSession[]
  communityReports  CommunityHazardReport[] @relation("CommunityReports")
  moderatedReports  CommunityHazardReport[] @relation("ModeratedReports")
  privacy           UserPrivacy?
  tripPhotos        TripPhoto[]

  @@index([email])
  @@index([username])
  @@map("user")
}

model UserHealth {
  id                String       @id @default(cuid())
  userId            String       @unique
  bloodType         String?
  fitnessLevel      FitnessLevel @default(MODERATE)
  mobilityLimited   Boolean      @default(false)
  chronicConditions String[]
  allergies         String[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  locationLat         Float?
  locationLng         Float?
  interests           String[]
  riskTolerance       String   @default("MEDIUM")
  travelStyle         String[]
  maxDistanceKm       Float?
  typicalDurationDays Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  email     String?
  relation  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contact")
}

model EmergencyAlert {
  id              String          @id @default(uuid())
  userId          String
  tripId          String?
  status          EmergencyStatus @default(ACTIVE)
  latitude        Float?
  longitude       Float?
  message         String?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip            TravelPlan?     @relation(fields: [tripId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@map("emergency_alert")
}

model LocationShareSession {
  id        String    @id @default(uuid())
  userId    String
  userName  String
  tripId    String?
  tripTitle String?
  shareLink String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      TravelPlan? @relation(fields: [tripId], references: [id])

  @@index([userId])
  @@index([shareLink])
  @@map("location_share_session")
}

model UserBehavior {
  id        String   @id @default(cuid())
  userId    String   @unique
  metrics   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  receiver    User             @relation("FriendReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  grantedScopes         String[]
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Destination {
  id                 String              @id @default(uuid())
  name               String
  normalizedName     String
  district           String
  province           String
  municipality       String?
  latitude           Float
  longitude          Float
  altitude           Float?
  category           DestinationCategory
  description        String?
  image              String?
  tags               String[]
  osmId              String?             @unique
  source             DestinationSource
  verified           Boolean             @default(false)
  verifiedBy         String?
  verifiedAt         DateTime?
  routeAccessible    Boolean             @default(true)
  coordinateAccuracy Float?
  dataQualityScore   Float?
  popularityScore    Float?
  confidenceScore    Float?
  accessibilityScore Float?
  tourismSupportScore Float?
  destinationTier    Int?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sourceLastFetch    DateTime?
  savedByUsers       SavedDestination[]
  photos             DestinationPhoto[]

  @@unique([name, district, province])
  @@index([normalizedName])
  @@index([district, province])
  @@index([latitude, longitude])
  @@index([category])
  @@index([verified])
  @@index([source])
  @@index([popularityScore])
  @@index([destinationTier])
  @@index([confidenceScore])
  @@map("destination")
}

model DestinationPhoto {
  id             String      @id @default(uuid())
  destinationId  String
  cloudinaryUrl  String
  sourceUrl      String
  thumbUrl       String?
  title          String?
  index          Int         @default(0)
  source         String      @default("commons")
  createdAt      DateTime    @default(now())
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, index])
  @@index([destinationId])
  @@map("destination_photo")
}

model Province {
  id        String     @id @default(uuid())
  name      String     @unique
  districts District[]
}

model District {
  id         String     @id @default(uuid())
  name       String
  provinceId String
  province   Province   @relation(fields: [provinceId], references: [id])
  locations  Location[]
  places     Place[]

  @@unique([name, provinceId])
}

model Location {
  id                String               @id @default(uuid())
  name              String
  districtId        String
  latitude          Float
  longitude         Float
  altitude          Int?
  createdAt         DateTime             @default(now())
  hazardData        HazardData[]
  district          District             @relation(fields: [districtId], references: [id])
  riskReports       RiskAssessment[]
  routeDestinations RouteTemplate[]      @relation("RouteTemplateDestination")
  routeOrigins      RouteTemplate[]      @relation("RouteTemplateOrigin")
  routePoints       RouteTemplatePoint[] @relation("RoutePointLocation")
  groupTrips        TravelGroup[]
  travelStops       TravelStop[]
  weatherData       WeatherData[]
  place             Place?
  residents         User[]               @relation("HomeLocation")
  communityReports  CommunityHazardReport[]

  @@unique([name, districtId])
  @@index([latitude, longitude])
}

model Place {
  id         String      @id @default(uuid())
  name       String
  nameEn     String?
  nameNe     String?
  type       PlaceType
  latitude   Float
  longitude  Float
  adminLevel Int?
  osmId      BigInt?
  osmType    String?
  parentId   String?
  districtId String?
  locationId String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  district   District?   @relation(fields: [districtId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])
  parent     Place?      @relation("PlaceHierarchy", fields: [parentId], references: [id])
  children   Place[]     @relation("PlaceHierarchy")
  routeNodes    RouteNode[]
  roadsFrom     RoadSegment[] @relation("RoadFromPlace")
  roadsTo       RoadSegment[] @relation("RoadToPlace")

  @@index([name])
  @@index([adminLevel])
  @@index([osmId])
  @@index([type])
  @@index([latitude, longitude])
  @@index([districtId])
  @@index([parentId])
  @@map("place")
}

model RouteNode {
  id                   String              @id @default(uuid())
  name                 String
  type                 PlaceType           @default(ROUTE_NODE)
  latitude             Float
  longitude            Float
  elevationM           Float?
  accessibilityLevel   NodeAccessibility?
  strategicImportance  StrategicImportance?
  hazardExposureIndex  Float?
  connectivityRank     Int?
  monsoonVulnerability Float?
  osmWayId             String?
  sequenceIndex        Int?
  roadClass            String?
  isJunctionNode       Boolean             @default(false)
  placeId              String?
  isHub                Boolean             @default(false)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  edgesFrom            RouteEdge[]         @relation("EdgeFrom")
  edgesTo              RouteEdge[]         @relation("EdgeTo")
  edgeCacheFrom        EdgeCache[]         @relation("EdgeCacheFrom")
  edgeCacheTo          EdgeCache[]         @relation("EdgeCacheTo")
  osmWay               OsmWay?             @relation(fields: [osmWayId], references: [id])
  place                Place?              @relation(fields: [placeId], references: [id])
  savedLocations       UserSavedLocation[]

  @@index([latitude, longitude])
  @@index([isHub, isActive])
  @@index([strategicImportance])
  @@index([osmWayId, sequenceIndex])
  @@map("route_node")
}

// LEGACY — not used in production routing. Kept for rollback/testing/shadow comparison.
// Replaced by OsmWay-based adjacency + dynamic edge scoring.
model RouteEdge {
  id                 String         @id @default(uuid())
  fromNodeId         String
  toNodeId           String
  distanceKm         Float
  surfaceType        RoadSurface?
  roadCondition      RoadCondition?
  travelReliability  Float?
  gradientPct        Float?
  landslideRisk      Float?
  floodRisk          Float?
  weatherSensitivity Float?
  reliabilityScore   Float?
  monsoonVulnerability Float?
  seasonalClosure    String?
  roadName           String?
  isBidirectional    Boolean        @default(true)
  fromNode           RouteNode      @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode             RouteNode      @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([roadCondition])
  @@index([travelReliability])
  @@map("route_edge_legacy")
}

model UserSavedLocation {
  userId             String     @id
  placeName          String
  latitude           Float
  longitude          Float
  nearestRouteNodeId String?
  accuracyMeters     Float?
  source             String     @default("manual")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  nearestRouteNode   RouteNode? @relation(fields: [nearestRouteNodeId], references: [id])
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_saved_location")
}

model SavedDestination {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  notes         String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@map("saved_destination")
}

model RouteTemplate {
  id                    String               @id @default(uuid())
  originLocationId      String
  destinationLocationId String
  name                  String
  distanceKm            Float?
  source                String?
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  destinationLocation   Location             @relation("RouteTemplateDestination", fields: [destinationLocationId], references: [id], onDelete: Cascade)
  originLocation        Location             @relation("RouteTemplateOrigin", fields: [originLocationId], references: [id], onDelete: Cascade)
  points                RouteTemplatePoint[]

  @@unique([originLocationId, destinationLocationId, name])
  @@index([originLocationId, destinationLocationId, isActive])
}

model RouteTemplatePoint {
  id                String        @id @default(uuid())
  routeTemplateId   String
  seq               Int
  lat               Float
  lon               Float
  kmFromStart       Float
  placeName         String?
  matchedLocationId String?
  createdAt         DateTime      @default(now())
  matchedLocation   Location?     @relation("RoutePointLocation", fields: [matchedLocationId], references: [id])
  routeTemplate     RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)

  @@unique([routeTemplateId, seq])
  @@index([routeTemplateId, seq])
  @@index([lat, lon])
}

model OsmWay {
  id              String      @id
  name            String?
  roadClass       String
  oneWay          Boolean     @default(false)
  graphVersion    String      // bumped on OSM reimport
  importBatchId   String?     // UUID of the import run
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  nodes           RouteNode[]

  @@map("osm_way")
}

model RoadSegment {
  id               String     @id @default(uuid())
  roadCode         String?    @unique
  roadNumber       String?
  name             String
  roadType         RoadType
  province         String?
  fromPlaceId      String?
  toPlaceId        String?
  lengthKm         Float?
  isActive         Boolean    @default(true)
  sourceConfidence Json?
  metadata         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  fromPlace        Place?     @relation("RoadFromPlace", fields: [fromPlaceId], references: [id])
  toPlace          Place?     @relation("RoadToPlace", fields: [toPlaceId], references: [id])

  @@index([roadCode])
  @@index([roadType])
  @@index([name])
  @@map("road_segment")
}

model RoadJunction {
  id        String       @id @default(uuid())
  name      String
  roadCodes String[]
  type      JunctionType
  latitude  Float
  longitude Float
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([latitude, longitude])
  @@map("road_junction")
}

model AdminRegion {
  id        String   @id @default(uuid())
  name      String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("admin_region")
}

model HazardHex {
  h3Index             String      @id
  centroidLat         Float
  centroidLon         Float
  landslideRisk       Float?
  floodRisk           Float?
  monsoonVulnerability Float?
  weatherSensitivity  Float?
  dataDate            DateTime    @default(now())
  modelVersion        String

  @@index([h3Index])
  @@map("hazard_hex")
}

model EdgeCache {
  id              String      @id @default(uuid())
  fromNodeId      String
  toNodeId        String
  distanceKm      Float
  gradientPct     Float?
  surfaceType     RoadSurface?
  compositeCost   Float
  riskSnapshotId  String?
  graphVersion    String
  season          String      // "monsoon" | "dry"
  ttl             DateTime
  computedAt      DateTime    @default(now())
  fromNode        RouteNode   @relation("EdgeCacheFrom", fields: [fromNodeId], references: [id])
  toNode          RouteNode   @relation("EdgeCacheTo", fields: [toNodeId], references: [id])

  @@unique([fromNodeId, toNodeId, graphVersion, season])
  @@index([ttl])
  @@map("edge_cache")
}

model RouteUsageLog {
  id              String      @id @default(uuid())
  userId          String?
  tripId          String?
  fallbackLevel   Int?        // 0=normal, 1=reduced-hazard, 2=distance-only
  segments        Json
  totalDistance   Float
  avgSafetyScore  Float?
  vehicleProfile  String?
  source          String?     // "dynamic-v1"
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("route_usage_log")
}

model RouteIntelligenceJob {
  id        String   @id @default(cuid())
  key       String                        // routeIntelligenceKey — single-flight dedup
  status    String   @default("pending")  // pending | processing | done | failed
  attempts  Int      @default(0)
  payload   Json
  result    Json?
  error     String?
  runAfter  DateTime @default(now())      // delayed start (backoff)
  lockUntil DateTime?                     // SKIP LOCKED guard
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
  @@index([status, runAfter])
  @@map("route_intelligence_job")
}

model WeatherData {
  id          String   @id @default(uuid())
  locationId  String
  temperature Float
  humidity    Float
  rainfall    Float
  windSpeed   Float
  pressure    Float?
  source      String?
  recordedAt  DateTime
  createdAt   DateTime @default(now())
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, recordedAt])
}

model HazardData {
  id             String   @id @default(uuid())
  locationId     String
  floodIndex     Float?
  landslideIndex Float?
  heatIndex      Float?
  airQuality     Float?
  source         String?
  recordedAt     DateTime
  createdAt      DateTime @default(now())
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, recordedAt])
}

model CommunityHazardReport {
  id              String             @id @default(uuid())
  userId          String
  hazardType      HazardReportType
  severity        ReportSeverity
  title           String
  description     String?
  lat             Float
  lng             Float
  locationId      String?
  imageUrl        String?
  status          HazardReportStatus @default(PENDING)
  moderatedBy     String?
  moderatedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user       User      @relation("CommunityReports", fields: [userId], references: [id], onDelete: Cascade)
  moderator  User?     @relation("ModeratedReports", fields: [moderatedBy], references: [id])
  location   Location? @relation(fields: [locationId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([lat, lng])
  @@map("community_hazard_report")
}

model RiskAssessment {
  id              String         @id @default(uuid())
  locationId      String
  type            AssessmentType
  safetyScore     Float
  safetyLevel     SafetyLevel
  confidence      Float?
  decisionTrace   Json
  weatherSnapshot Json?
  hazardSnapshot  Json?
  modelVersion    String?
  createdAt       DateTime       @default(now())
  location        Location       @relation(fields: [locationId], references: [id])

  @@index([locationId, createdAt])
}

model TravelPlan {
  id              String             @id @default(uuid())
  title           String
  leaderId        String
  tripType        AssessmentType     @default(SOLO)
  status          TravelStatus       @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  budgetNPR       Float?
  groupRiskResult Json?
  startNotifiedAt DateTime?
  endNotifiedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  leader              User               @relation("TripLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members             TravelPlanMember[]
  stops               TravelStop[]
  emergencyAlerts     EmergencyAlert[]
  locationShareSessions LocationShareSession[]

  @@index([leaderId])
}

model TravelStop {
  id            String     @id @default(uuid())
  planId        String
  locationId    String
  stopOrder     Int
  arrivalDate   DateTime
  departureDate DateTime
  riskSnapshot  Json?
  location      Location   @relation(fields: [locationId], references: [id])
  plan          TravelPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, stopOrder])
  @@index([planId])
}

model TravelPlanMember {
  id           String       @id @default(uuid())
  planId       String
  userId       String
  status       MemberStatus @default(PENDING)
  invitedAt    DateTime     @default(now())
  respondedAt  DateTime?
  riskSnapshot Json?
  plan         TravelPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([planId])
  @@index([userId])
}

model TravelGroup {
  id            String              @id @default(uuid())
  name          String
  destinationId String
  startDate     DateTime
  endDate       DateTime
  status        TravelStatus        @default(PENDING)
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User                @relation("GroupCreator", fields: [createdById], references: [id])
  destination   Location            @relation(fields: [destinationId], references: [id])
  members       TravelGroupMember[]

  @@index([destinationId])
}

model TravelGroupMember {
  id       String      @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime    @default(now())
  group    TravelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

model yatra_disaster_events {
  id          BigInt   @id @default(autoincrement())
  external_id String
  type        String
  lat         Float
  lon         Float
  date        DateTime @db.Timestamptz(6)
  severity    String
  source      String
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([source, external_id])
  @@index([date], map: "idx_disaster_events_date")
  @@index([lat, lon], map: "idx_disaster_events_lat_lon")
  @@index([type], map: "idx_disaster_events_type")
}

enum EmergencyStatus {
  ACTIVE
  RESPONDED
  RESOLVED
  FALSE_ALARM
}

enum Role {
  USER
  ADMIN
  ANALYST
}

enum SafetyLevel {
  SAFE
  CAUTION
  HIGH_RISK
  EXTREME
}

enum TravelStatus {
  PENDING
  ANALYZED
  APPROVED
  COMPLETED
  CANCELLED
}

enum AssessmentType {
  SOLO
  GROUP
}

enum FitnessLevel {
  LOW
  MODERATE
  HIGH
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum MemberStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NodeAccessibility {
  YEAR_ROUND
  SEASONAL
  DIFFICULT
  IMPASSABLE
}

enum StrategicImportance {
  MAJOR_HIGHWAY
  REGIONAL_HUB
  BORDER_CROSSING
  TOURIST_GATEWAY
  MOUNTAIN_PASS
  RIVER_CROSSING
  TRANSIT_HUB
  LOCAL_ROAD
}

enum RoadCondition {
